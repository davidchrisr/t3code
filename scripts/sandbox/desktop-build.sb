(version 1)
(import "/System/Library/Sandbox/Profiles/bsd.sb")
(deny default)

(allow process* sysctl-read mach-lookup)
(allow signal (target same-sandbox))
(allow network*)
(system-network)
(allow pseudo-tty)

; Keep host tools and the selected SDK readable, but never writable.
(allow file-read* file-test-existence file-map-executable process-exec
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/usr/bin")
  (subpath "/usr/sbin")
  (subpath "/usr/libexec")
  (subpath (param "DEVELOPER_ROOT"))
  (subpath (param "NODE_DIR"))
  (subpath (param "VP_DIR"))
  (subpath (param "CARGO_BIN_DIR"))
  (subpath (param "RUSTUP_HOME"))
  (subpath (string-append (param "HOMEBREW_PREFIX") "/Cellar"))
  (subpath (string-append (param "HOMEBREW_PREFIX") "/opt")))

(allow file-read*
  (literal "/private/etc/ssl/openssl.cnf")
  (literal "/private/etc/ssl/cert.pem")
  (literal "/Library/Preferences/com.apple.security.plist")
  (literal "/Library/Preferences/com.apple.dt.Xcode.plist")
  (literal "/Library/Preferences/.GlobalPreferences.plist"))
(allow user-preference-read
  (preference-domain "com.apple.security")
  (preference-domain ".GlobalPreferences"))

; Shared bootstrap files and run parents are readable but never writable.
(allow file-read* file-test-existence
  (subpath (param "BUILD_ROOT")))

; Children can modify their run, shared caches, and current artifacts only.
(allow file-read* file-write* file-test-existence file-ioctl file-map-executable process-exec
  (subpath (param "RUN_DIR"))
  (subpath (param "CACHE_DIR"))
  (subpath (param "OUTPUT_DIR")))
; Preserve the cache root that later invocations use to initialize their policy.
(deny file-write-create file-write-unlink
  (literal (param "CACHE_DIR")))

(allow file-write* (literal "/dev/null"))
(allow file-read* file-write* file-ioctl
  (literal "/dev/ptmx")
  (literal "/dev/tty")
  (regex "^/dev/ttys[0-9]*"))
